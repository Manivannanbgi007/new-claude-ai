# ---------------------------------------------------------------
# Infrastructure versions and settings (LOCAL DEVELOPMENT ONLY)
# Never commit real passwords. Commit a copy without secrets as .env.example.
# ---------------------------------------------------------------

# Elastic Stack (Elasticsearch + Kibana) - always the same version for both
ELASTIC_VERSION=9.2.0
ES_CLUSTER_NAME=product-cluster
ES_HEAP=1g
ES_PORT=9200
KIBANA_PORT=5601

# Ollama (local LLM runtime)
OLLAMA_VERSION=0.12.0
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_CONTEXT_LENGTH=8192

# MySQL (stock-service now, order-service later)
MYSQL_VERSION=8.4
# 3307 on your machine avoids a clash with a locally installed MySQL on 3306
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root_dev_password
# Database + user owned by stock-service. The user gets rights on this database only.
STOCK_DB_NAME=stock_db
STOCK_DB_USER=stock_user
STOCK_DB_PASSWORD=stock_dev_password
