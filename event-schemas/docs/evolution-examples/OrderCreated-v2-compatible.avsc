{
  "type": "record",
  "name": "OrderCreated",
  "namespace": "com.example.events.order",
  "doc": "Owner: order-service. Topic: order.events.v1, key = orderId. A customer placed an order; starts the order saga.",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Unique id (UUID) of this event. Consumers use it to detect duplicates."
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "When the event happened (UTC)."
    },
    {
      "name": "correlationId",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Traces one business flow across services and logs."
    },
    {
      "name": "orderId",
      "type": "string"
    },
    {
      "name": "customerId",
      "type": "string"
    },
    {
      "name": "currency",
      "type": "string",
      "default": "USD",
      "doc": "ISO 4217 currency code."
    },
    {
      "name": "totalAmount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 12,
        "scale": 2
      }
    },
    {
      "name": "items",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "OrderLine",
          "fields": [
            {
              "name": "sku",
              "type": "string"
            },
            {
              "name": "productName",
              "type": "string"
            },
            {
              "name": "quantity",
              "type": "int"
            },
            {
              "name": "unitPrice",
              "type": {
                "type": "bytes",
                "logicalType": "decimal",
                "precision": 12,
                "scale": 2
              }
            }
          ]
        }
      }
    },
    {
      "name": "customerNote",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "v2: optional note from the customer. Has a default => FULL compatible."
    }
  ]
}