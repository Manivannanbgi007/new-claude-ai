# ---------------------------------------------------------------
# Infrastructure versions and settings (LOCAL DEVELOPMENT ONLY)
# Never commit real passwords. Commit a copy without secrets as .env.example.
# ---------------------------------------------------------------

# Elastic Stack (Elasticsearch + Kibana) - always the same version for both
ELASTIC_VERSION=9.2.0
ES_CLUSTER_NAME=product-cluster
ES_HEAP=1g
ES_PORT=9200
KIBANA_PORT=5601

# Ollama (local LLM runtime)
OLLAMA_VERSION=0.12.0
OLLAMA_PORT=11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_CONTEXT_LENGTH=8192

# Shared MySQL (stock-service: stock_db)
MYSQL_VERSION=8.4
# 3307 on your machine avoids a clash with a locally installed MySQL on 3306
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root_dev_password
# Database + user owned by stock-service. The user gets rights on this database only.
STOCK_DB_NAME=stock_db
STOCK_DB_USER=stock_user
STOCK_DB_PASSWORD=stock_dev_password

# ---------------------------------------------------------------
# mysql-user: DEDICATED MySQL for user-service (database per service)
# Database and user below are created automatically on the FIRST start (empty volume).
# ---------------------------------------------------------------
# 3309 on your machine (3307 = shared mysql, 3308 = mysql-product)
USER_MYSQL_PORT=3309
USER_MYSQL_ROOT_PASSWORD=user_root_dev_password
USER_DB_NAME=user_db
USER_DB_USER=user_user
USER_DB_PASSWORD=user_dev_password

# ---------------------------------------------------------------
# mysql-order: DEDICATED MySQL for order-service (database per service)
# Database and user are created automatically on the FIRST start (empty volume).
# ---------------------------------------------------------------
ORDER_MYSQL_PORT=3310
ORDER_MYSQL_ROOT_PASSWORD=order_root_dev_password
ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_dev_password

# Confluent Platform (Kafka in KRaft mode + Schema Registry)
CONFLUENT_VERSION=8.0.0
# Fixed id of the local KRaft cluster (22-character base64 UUID). Keep it stable.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Port for apps running on your machine (localhost:9092)
KAFKA_PORT=9092
# 18081 on your machine because product-service already uses 8081
SCHEMA_REGISTRY_PORT=18081
KAFKA_UI_VERSION=v1.1.0
KAFKA_UI_PORT=8088

# ---------------------------------------------------------------
# mysql-product: DEDICATED MySQL for product-write-service (captured by Debezium)
# Database and user below are created automatically on the FIRST start (empty volume).
# ---------------------------------------------------------------
# 3308 on your machine (3307 = shared mysql for stock/order)
PRODUCT_MYSQL_PORT=3308
PRODUCT_MYSQL_ROOT_PASSWORD=product_root_dev_password
PRODUCT_DB_NAME=product_db
PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=product_dev_password
# Debezium's read-only replication user (must match debezium/product-cdc-connector.json)
DEBEZIUM_DB_USER=debezium
DEBEZIUM_DB_PASSWORD=debezium_dev_password

# Debezium (Kafka Connect with the Debezium MySQL connector)
DEBEZIUM_VERSION=3.2.0.Final
KAFKA_CONNECT_PORT=8083

# ---------------------------------------------------------------
# RAG service
# ---------------------------------------------------------------
# Embedding model in Ollama (768 dimensions - must match rag-service's vector column)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# postgres-rag: PostgreSQL + pgvector (database per service). 5433 avoids a local Postgres on 5432.
PGVECTOR_VERSION=pg17
RAG_DB_PORT=5433
RAG_DB_NAME=rag_db
RAG_DB_USER=rag_user
RAG_DB_PASSWORD=rag_dev_password

# Reranker: Hugging Face Text Embeddings Inference serving a cross-encoder model
RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_PORT=8095

# pgAdmin 4: web UI for postgres-rag (http://localhost:5050)
PGADMIN_VERSION=9.4
PGADMIN_PORT=5050
# Required by the image even in desktop mode (no login screen is shown locally)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_dev_password

# Redis: shared rate-limit counters for the API Gateway (token buckets)
REDIS_VERSION=7.4-alpine
REDIS_PORT=6379
